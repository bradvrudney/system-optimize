#!/usr/bin/env bash
# system-optimize - tune a Linux machine for its hardware, reversibly:
# kernel settings sized to its RAM and swap, disk I/O schedulers, the CPU
# power profile, open-file limits and SSD trim, plus a report of the
# well-known helpers (tuned, earlyoom, systemd-oomd, zram, irqbalance, ...)
# that can install the missing ones. Every real run saves a snapshot that
# --undo restores.
#
# The entry point. It resolves its own location through symlinks, loads the
# modules from ../lib and runs. Requires bash 4.4 or newer.
#
# A modular rewrite of Ed Reel's system-optimize
# (https://github.com/uberhacker/system-optimize). GPL-3.0, see LICENSE.

set -uo pipefail

if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "system-optimize needs bash 4.4 or newer (found ${BASH_VERSION:-unknown})" >&2
  exit 1
fi

# The core relies on a few external commands (coreutils or BusyBox, grep,
# sed); say which one is missing up front instead of failing inside a step.
for _so_cmd in mktemp readlink grep sed sort; do
  if ! command -v "$_so_cmd" >/dev/null 2>&1; then
    echo "system-optimize needs '$_so_cmd' on PATH (coreutils or BusyBox, grep and sed are required)" >&2
    exit 1
  fi
done
unset _so_cmd

# so_resolve_self: absolute path of this file, following symlinks.
so_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}
# SO_BIN is this program's real path. SO_ROOT_DIR is the tree it was loaded
# from: the directory above bin/, or for a single-file build the directory
# holding the file. SO_BUNDLED is a build constant, not a setting: build.sh
# rewrites the next line to SO_BUNDLED=1.
SO_BUNDLED=0
SO_BIN=$(so_resolve_self)
if [ "$SO_BUNDLED" = 1 ]; then
  SO_ROOT_DIR=$(dirname "$SO_BIN")
else
  SO_ROOT_DIR=$(cd -P "$(dirname "$SO_BIN")/.." && pwd)
fi
export SO_ROOT_DIR

# Modules. build.sh replaces everything between the two markers with the
# modules' contents to make the single-file build.
# @@BUNDLE-MODULES-BEGIN@@
# shellcheck source=lib/core/log.sh
source "$SO_ROOT_DIR/lib/core/log.sh"
# shellcheck source=lib/core/util.sh
source "$SO_ROOT_DIR/lib/core/util.sh"
# shellcheck source=lib/core/config.sh
source "$SO_ROOT_DIR/lib/core/config.sh"
# shellcheck source=lib/core/args.sh
source "$SO_ROOT_DIR/lib/core/args.sh"
# shellcheck source=lib/core/sysinfo.sh
source "$SO_ROOT_DIR/lib/core/sysinfo.sh"
# shellcheck source=lib/core/os.sh
source "$SO_ROOT_DIR/lib/core/os.sh"
# shellcheck source=lib/core/runner.sh
source "$SO_ROOT_DIR/lib/core/runner.sh"
# shellcheck source=lib/core/runlog.sh
source "$SO_ROOT_DIR/lib/core/runlog.sh"
# shellcheck source=lib/core/snapshot.sh
source "$SO_ROOT_DIR/lib/core/snapshot.sh"
# shellcheck source=lib/core/selfupdate.sh
source "$SO_ROOT_DIR/lib/core/selfupdate.sh"
# shellcheck source=lib/tweaks/legacy.sh
source "$SO_ROOT_DIR/lib/tweaks/legacy.sh"
# shellcheck source=lib/tweaks/sysctl.sh
source "$SO_ROOT_DIR/lib/tweaks/sysctl.sh"
# shellcheck source=lib/tweaks/io.sh
source "$SO_ROOT_DIR/lib/tweaks/io.sh"
# shellcheck source=lib/tweaks/cpu.sh
source "$SO_ROOT_DIR/lib/tweaks/cpu.sh"
# shellcheck source=lib/tweaks/limits.sh
source "$SO_ROOT_DIR/lib/tweaks/limits.sh"
# shellcheck source=lib/tweaks/trim.sh
source "$SO_ROOT_DIR/lib/tweaks/trim.sh"
# shellcheck source=lib/tweaks/tools.sh
source "$SO_ROOT_DIR/lib/tweaks/tools.sh"
# shellcheck source=lib/core/status.sh
source "$SO_ROOT_DIR/lib/core/status.sh"
# @@BUNDLE-MODULES-END@@

# version_string: "system-optimize X.Y.Z (git abcdef1)"
version_string() {
  local v commit=""
  if [ "$SO_BUNDLED" = 1 ]; then
    printf 'system-optimize %s (git %s, single file)\n' "${SO_BUNDLE_VERSION:-unknown}" "${SO_BUNDLE_COMMIT:-unknown}"
    return 0
  fi
  v=$(tr -d '[:space:]' < "$SO_ROOT_DIR/VERSION" 2>/dev/null || echo unknown)
  if [ -e "$SO_ROOT_DIR/.git" ] && has_cmd git; then
    commit=$(git -C "$SO_ROOT_DIR" rev-parse --short HEAD 2>/dev/null || true)
  fi
  printf 'system-optimize %s%s\n' "$v" "${commit:+ (git $commit)}"
}

# completion_main SHELL: print the completion script (--completion bash).
# A single-file build carries it as so_completion_script (added by build.sh).
completion_main() {
  case "$1" in
    bash|zsh) ;;
    *) echo "system-optimize: --completion supports bash (zsh can load it with bashcompinit)" >&2; return 2 ;;
  esac
  if declare -F so_completion_script >/dev/null; then
    so_completion_script
  else
    cat -- "$SO_ROOT_DIR/completions/system-optimize.bash"
  fi
}

# preflight: may this run change the system? A dry run only warns.
preflight() {
  local os
  os=$(uname -s 2>/dev/null)
  if [ "$os" != Linux ]; then
    log_error "system-optimize only runs on Linux (this is ${os:-unknown})"
    return 1
  fi
  if [ ! -r "$(so_path /proc/meminfo)" ]; then
    log_error "cannot read $(so_path /proc/meminfo); is /proc mounted?"
    return 1
  fi
  # --undo only reverses what a run recorded, so it needs no --force.
  if [ "$SO_IN_CONTAINER" = 1 ] && [ "$SO_ARG_MODE" != undo ]; then
    if [ "$SO_DRY_RUN" = 1 ]; then
      log_warn "running in a container ($SO_CONTAINER_NAME): a real run would refuse without --force"
    elif cfg_bool FORCE; then
      log_warn "running in a container ($SO_CONTAINER_NAME); going ahead because of --force"
    else
      log_error "running in a container ($SO_CONTAINER_NAME): its kernel, disks and CPUs belong to the host"
      log_info "run it on the host, or pass --force to change the container's own files anyway"
      return 1
    fi
  fi
  if [ "$SO_DRY_RUN" != 1 ] && ! is_root && [ "${SO_SKIP_ROOT_CHECK:-0}" != 1 ]; then
    log_error "changing the system needs root: sudo $(basename -- "$0")${SO_COMMAND_ARGS:+ $SO_COMMAND_ARGS}"
    log_info "--dry-run and --status work without root"
    return 1
  fi
  return 0
}

# apply_main: the optimisation run.
apply_main() {
  local steps
  steps=$(for s in "${SO_STEPS[@]}"; do step_enabled "$s" && printf '%s ' "$s"; done)
  if [ "$SO_DRY_RUN" != 1 ]; then
    log_info "a snapshot of everything changed is saved first; system-optimize --undo restores it"
    confirm "Apply the optimizations (${steps% })?" || return 1
  fi
  run_step legacy tweak_legacy
  run_step sysctl tweak_sysctl
  run_step io tweak_io
  run_step cpu tweak_cpu
  run_step limits tweak_limits
  run_step trim tweak_trim
  run_step tools tweak_tools
  return 0
}

main() {
  local rc=0 mode

  user_init
  SO_COMMAND_ARGS=$(so_quote "$@")
  SO_COMMAND_LINE="system-optimize${SO_COMMAND_ARGS:+ $SO_COMMAND_ARGS}"
  if ! args_parse "$@"; then
    log_plain ""
    usage >&2
    exit 2
  fi
  if [ "$SO_ARG_HELP" = 1 ]; then usage; exit 0; fi
  if [ "$SO_ARG_VERSION" = 1 ]; then version_string; exit 0; fi
  if [ -n "$SO_ARG_COMPLETION" ]; then completion_main "$SO_ARG_COMPLETION"; exit $?; fi

  [ -n "$SO_CONFIG_FILE" ] && [[ "$SO_CONFIG_FILE" != /* ]] && SO_CONFIG_FILE="$PWD/$SO_CONFIG_FILE"
  [ -n "$SO_LOG_PATH" ] && [[ "$SO_LOG_PATH" != /* ]] && SO_LOG_PATH="$PWD/$SO_LOG_PATH"
  config_load
  args_apply || exit 2

  if [ "$SO_ARG_SELF_UPDATE" = 1 ]; then
    [ "$SO_QUIET" = 1 ] && exec >/dev/null 2>&1
    runlog_open self-update "$@"
    selfupdate_main || rc=1
    [ -n "$SO_LOG_FILE" ] && log_plain "  log: $SO_LOG_FILE"
    runlog_close "$rc"
    exit "$rc"
  fi

  sysinfo_detect
  mode="$SO_ARG_MODE"
  case "$mode" in
    status)
      log_plain "${C_BOLD}$(version_string)${C_RESET}"
      status_main
      exit 0 ;;
    list-snapshots)
      list_snapshots_main
      exit 0 ;;
  esac

  # --quiet hides third-party output (it is still in the run log). Our own
  # lines go to the console descriptor SO_OUT and are unaffected.
  [ "$SO_QUIET" = 1 ] && exec >/dev/null 2>&1
  runlog_open "$mode" "$@"
  log_plain "${C_BOLD}$(version_string)${C_RESET} on $(sysinfo_describe_os)"
  log_plain "  $(sysinfo_describe_hw)"
  if [ "$SO_DRY_RUN" = 1 ]; then
    log_plain "${C_MAGENTA}dry run: nothing will be changed${C_RESET}"
  fi

  if preflight; then
    case "$mode" in
      undo) undo_main "$SO_ARG_SNAPSHOT" || rc=1 ;;
      *) apply_main || rc=1 ;;
    esac
  else
    rc=1
  fi
  summary_print || rc=1
  if [ -n "$SO_SNAP" ]; then
    log_plain "  snapshot: ${SO_SNAP##*/} (undo: system-optimize --undo ${SO_SNAP##*/})"
  fi
  [ -n "$SO_LOG_FILE" ] && log_plain "  log: $SO_LOG_FILE"
  runlog_close "$rc"
  exit "$rc"
}

main "$@"
