#!/usr/bin/env bash
#
# Linux Hardware-Aware Performance Optimizer
# Analyzes hardware, kernel, and disks to apply proportional tweaks.
# Supports dry-run simulation mode and logs all outputs to /var/log/.
#
set -euo pipefail

# -------------------------------------------------------------
# 0. Argument Parsing & Dry-Run Flag
# -------------------------------------------------------------
DRY_RUN=false

usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS]

Options:
    -d, --dry-run    Simulate optimizations without making any system changes.
    -h, --help       Show this help message.

EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            ;;
    esac
done

# -------------------------------------------------------------
# 1. Safety, Privilege Checks & Logging Setup
# -------------------------------------------------------------
if [[ $EUID -ne 0 ]]; then
    echo "[ERROR] This script must be run as root (or with sudo)." >&2
    exit 1
fi

TIMESTAMP=$(date +%Y%m%d%H%M%S)
LOG_FILE="/var/log/system-optimize-${TIMESTAMP}.log"
LATEST_LOG_LINK="/var/log/system-optimize.log"
BACKUP_DIR="$HOME/system-optimize/backups/${TIMESTAMP}"

# Only create backup directory if changes will actually be made
if [[ "$DRY_RUN" == false ]]; then
    mkdir -p "$BACKUP_DIR"
fi

touch "$LOG_FILE"
chmod 640 "$LOG_FILE"

# Create/update symlink to latest log file
ln -sf "$LOG_FILE" "$LATEST_LOG_LINK"

# Redirect stdout and stderr to both terminal and log file
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=========================================================="
if [[ "$DRY_RUN" == true ]]; then
    echo " *** RUNNING IN DRY-RUN MODE (NO CHANGES WILL BE MADE) ***"
fi
echo " Starting System Performance Optimization"
echo " Date/Time: $(date)"
echo " Log file:  $LOG_FILE (Symlinked to $LATEST_LOG_LINK)"
if [[ "$DRY_RUN" == false ]]; then
    echo " Backups:   $BACKUP_DIR"
fi
echo "=========================================================="

# -------------------------------------------------------------
# Helper Functions for Dry-Run Safety
# -------------------------------------------------------------
# Writes contents from stdin to a target file
apply_file() {
    local target="$1"
    if [[ "$DRY_RUN" == true ]]; then
        echo "    [DRY-RUN] Would write file: $target"
        # Discard stdin content
        cat > /dev/null
    else
        [[ -f "$target" ]] && cp "$target" "$BACKUP_DIR/"
        cat > "$target"
        echo "    - Successfully configured: $target"
    fi
}

# Writes a single value to a pseudo-filesystem path (e.g. /sys)
apply_sysfs() {
    local value="$1"
    local target="$2"
    local desc="${3:-}"
    if [[ "$DRY_RUN" == true ]]; then
        echo "    [DRY-RUN] Would write '$value' to $target ($desc)"
    else
        echo "$value" > "$target" 2>/dev/null || true
        echo "    - Disk/CPU config: set $desc to '$value'"
    fi
}

# -------------------------------------------------------------
# 2. Hardware & Environment Detection
# -------------------------------------------------------------
echo "[*] Analyzing hardware and environment..."

# Detect RAM in MB
TOTAL_RAM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
TOTAL_RAM_MB=$((TOTAL_RAM_KB / 1024))
TOTAL_RAM_GB=$((TOTAL_RAM_MB / 1024))

# Detect CPU Cores
CPU_CORES=$(nproc)

# Detect Virtualization
IS_VIRT="bare-metal"
if command -v systemd-detect-virt &>/dev/null; then
    VIRT_TYPE=$(systemd-detect-virt || true)
    if [[ "$VIRT_TYPE" != "none" && -n "$VIRT_TYPE" ]]; then
        IS_VIRT="virtualized ($VIRT_TYPE)"
    fi
fi

# Detect Kernel Version
KERNEL_MAJOR=$(uname -r | cut -d. -f1)
KERNEL_MINOR=$(uname -r | cut -d. -f2)

echo "    - CPU Cores: $CPU_CORES"
echo "    - Total RAM: ${TOTAL_RAM_GB} GB (${TOTAL_RAM_MB} MB)"
echo "    - Environment: $IS_VIRT"
echo "    - Kernel: $(uname -r)"

# -------------------------------------------------------------
# 3. Virtual Memory & Kernel Tuning (sysctl)
# -------------------------------------------------------------
echo "[*] Configuring kernel sysctl parameters..."

SYSCTL_CONF="/etc/sysctl.d/99-hardware-optimization.conf"

# Generate configuration content in memory
SYSCTL_CONTENT=$(cat << 'EOF'
# Generated by Linux Hardware-Aware Optimizer
# -------------------------------------------------------------

# File System & Inode limits
fs.file-max = 2097152
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 1024

# Network core optimizations
net.core.somaxconn = 4096
net.core.netdev_max_backlog = 16384
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
EOF
)

# Append memory-proportional settings
if [[ $TOTAL_RAM_GB -ge 32 ]]; then
    SYSCTL_CONTENT+=$'\n# High RAM settings\nvm.swappiness = 10\nvm.vfs_cache_pressure = 50\nvm.dirty_background_ratio = 3\nvm.dirty_ratio = 10'
elif [[ $TOTAL_RAM_GB -ge 8 ]]; then
    SYSCTL_CONTENT+=$'\n# Medium RAM settings\nvm.swappiness = 20\nvm.vfs_cache_pressure = 75\nvm.dirty_background_ratio = 5\nvm.dirty_ratio = 15'
else
    SYSCTL_CONTENT+=$'\n# Low RAM settings\nvm.swappiness = 60\nvm.vfs_cache_pressure = 100\nvm.dirty_background_ratio = 10\nvm.dirty_ratio = 20'
fi

# Modern Congestion Control: TCP BBR (Requires Kernel >= 4.9)
BBR_AVAILABLE=false
if [[ "$KERNEL_MAJOR" -gt 4 ]] || [[ "$KERNEL_MAJOR" -eq 4 && "$KERNEL_MINOR" -ge 9 ]]; then
    if [[ "$DRY_RUN" == true ]]; then
        # Check without loading the module in dry run
        if modinfo tcp_bbr &>/dev/null; then
            BBR_AVAILABLE=true
        fi
    else
        if modprobe tcp_bbr 2>/dev/null; then
            BBR_AVAILABLE=true
        fi
    fi
fi

if [[ "$BBR_AVAILABLE" == true ]]; then
    SYSCTL_CONTENT+=$'\n# BBR Congestion Control\nnet.core.default_qdisc = fq\nnet.ipv4.tcp_congestion_control = bbr'
    echo "    - TCP BBR congestion control identified as available."
fi

# Apply the sysctl config via helper
echo "$SYSCTL_CONTENT" | apply_file "$SYSCTL_CONF"

if [[ "$DRY_RUN" == true ]]; then
    echo "    [DRY-RUN] Would execute: sysctl --system"
else
    sysctl --system > /dev/null
    echo "    - Loaded sysctl rules into active runtime."
fi

# -------------------------------------------------------------
# 4. Storage I/O Optimization
# -------------------------------------------------------------
echo "[*] Analyzing and tuning storage devices..."

# Loop over physical block devices
for disk in /sys/block/*; do
    DISK_NAME=$(basename "$disk")

    # Skip loop, ram, and virtual mapper devices
    [[ "$DISK_NAME" =~ ^(loop|ram|dm-|zram) ]] && continue
    [[ ! -d "$disk/queue" ]] && continue

    ROTATIONAL=$(cat "$disk/queue/rotational" 2>/dev/null || echo "1")
    AVAILABLE_SCHEDULERS=$(cat "$disk/queue/scheduler" 2>/dev/null || echo "")

    if [[ "$ROTATIONAL" -eq 0 ]]; then
        # Solid State Device (NVMe or SATA SSD)
        if [[ "$DISK_NAME" =~ ^nvme ]]; then
            # NVMe drives benefit most from 'none'
            if [[ "$AVAILABLE_SCHEDULERS" =~ "none" ]]; then
                apply_sysfs "none" "$disk/queue/scheduler" "$DISK_NAME (NVMe SSD) scheduler"
            fi
        else
            if [[ "$AVAILABLE_SCHEDULERS" =~ "mq-deadline" ]]; then
                apply_sysfs "mq-deadline" "$disk/queue/scheduler" "$DISK_NAME (SATA SSD) scheduler"
            fi
        fi
        apply_sysfs "256" "$disk/queue/read_ahead_kb" "$DISK_NAME read_ahead_kb"
    else
        # Mechanical HDD
        if [[ "$AVAILABLE_SCHEDULERS" =~ "bfq" ]]; then
            apply_sysfs "bfq" "$disk/queue/scheduler" "$DISK_NAME (Rotational HDD) scheduler"
        fi
        apply_sysfs "1024" "$disk/queue/read_ahead_kb" "$DISK_NAME read_ahead_kb"
    fi
done

# -------------------------------------------------------------
# 5. CPU Governor Tuning
# -------------------------------------------------------------
echo "[*] Checking CPU frequency governors..."

if [[ -d "/sys/devices/system/cpu/cpu0/cpufreq" ]]; then
    GOVERNOR="performance"
    # If battery-powered, use schedutil
    if [[ -d "/sys/class/power_supply" ]] && grep -q "Battery" /sys/class/power_supply/*/type 2>/dev/null; then
        GOVERNOR="schedutil"
    fi

    for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        if grep -q "$GOVERNOR" "${gov%/*}/scaling_available_governors" 2>/dev/null; then
            apply_sysfs "$GOVERNOR" "$gov" "$(basename "$(dirname "$gov")") governor"
        fi
    done
else
    echo "    - CPU Scaling Governor control not exposed directly (VM or driver managed)."
fi

# -------------------------------------------------------------
# 6. User Resource Limits (limits.conf)
# -------------------------------------------------------------
echo "[*] Optimizing system resource limits (/etc/security/limits.d/)..."

LIMITS_CONF="/etc/security/limits.d/99-performance.conf"

cat << 'EOF' | apply_file "$LIMITS_CONF"
# Increased open file limits for high-concurrency workloads
*         soft    nofile      65535
*         hard    nofile      524288
root      soft    nofile      65535
root      hard    nofile      524288
*         soft    nproc       65535
*         hard    nproc       65535
EOF

# -------------------------------------------------------------
# 7. Disk Queue Rule Persistence (udev)
# -------------------------------------------------------------
echo "[*] Making disk scheduler choices persistent across reboots..."

UDEV_RULE="/etc/udev/rules.d/60-disk-scheduler.rules"

cat << 'EOF' | apply_file "$UDEV_RULE"
# NVMe drives
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"
# SATA SSDs
ACTION=="add|change", KERNEL=="sd[a-z]|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# Rotational Disks (HDDs)
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF

if [[ "$DRY_RUN" == true ]]; then
    echo "    [DRY-RUN] Would execute: udevadm control --reload-rules"
else
    udevadm control --reload-rules 2>/dev/null || true
fi

# -------------------------------------------------------------
# Summary
# -------------------------------------------------------------
echo "=========================================================="
if [[ "$DRY_RUN" == true ]]; then
    echo " Dry Run Complete! No settings were modified."
else
    echo " Optimization Complete!"
    echo " Backups are saved in: $BACKUP_DIR"
fi
echo " Latest log:  $LATEST_LOG_LINK"
echo " Finished at: $(date)"
echo "=========================================================="
