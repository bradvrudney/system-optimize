# system-optimize configuration
#
# Copy to ${XDG_CONFIG_HOME:-~/.config}/system-optimize/config (per user) or
# /etc/system-optimize.conf (system wide; the one sudo runs read unless the
# user's file is passed with --config). Simple KEY=value lines; the file is
# parsed, never sourced, so no shell syntax is interpreted. Quotes around a
# value are optional. Unknown keys and invalid values are ignored with a
# warning. Environment variables with the same names override the files;
# command line flags override everything.

# Steps to run exclusively or to skip (comma separated). Steps: legacy,
# sysctl, io, cpu, limits, trim, tools. Also --only / --skip.
#ONLY=
#SKIP=cpu,limits

# Install and enable the recommended helpers that are missing (earlyoom or
# systemd-oomd, irqbalance, zram-generator). Also --install-tools.
#INSTALL_TOOLS=0

# Run even where a pre-flight check says no (inside a container). Also --force.
#FORCE=0

# Where snapshots for --undo are kept (absolute path).
# Empty: /var/lib/system-optimize/snapshots.
#SNAPSHOT_DIR=

# Seconds a command may take before it is killed: sysctl, udevadm,
# systemctl, powerprofilesctl (default 300). Also --timeout.
#TIMEOUT=300

# Seconds a package install or removal may take (default 1800).
#PKG_TIMEOUT=1800

# Seconds a download may take (default 300; --self-update).
#DOWNLOAD_TIMEOUT=300

# Where --self-update pulls this program from (https:// only). A git checkout
# with nothing configured follows the remote it was cloned from; a tree or
# single-file installation uses the repository below. Set it to follow a
# fork, for example:
#SELF_UPDATE_REPO=https://github.com/bradvrudney/system-optimize

# Branch for --self-update of a git checkout or a tree installation. Empty
# (default) follows the checkout's current branch if the remote has it,
# otherwise the remote's default branch. A single-file installation follows
# the GitHub releases instead and ignores this.
#SELF_UPDATE_BRANCH=

# Colour output: auto (TTY only, honours NO_COLOR), always, never.
#COLOR=auto

# Write a log file for every run (also --no-log / --log FILE). The log has a
# header describing the run and the machine, every message including the
# ones --quiet hides and the verbose-only commands, and each command's full
# output, exit status and duration, with timestamps and without colours.
# Files are 0600 in a 0700 directory.
#LOGGING=1

# Where logs go (absolute path). Empty: /var/log/system-optimize when run as
# root, ${XDG_STATE_HOME:-~/.local/state}/system-optimize otherwise.
#LOG_DIR=

# How many logs to keep in LOG_DIR; older ones are deleted. 0 keeps all.
#LOG_KEEP=20
